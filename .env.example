# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest  # tried when the main model is overloaded
LOCAL_TRANSCRIBER=whisper     # whisper (faster-whisper) or gemini (no model download, uses GEMINI_API_KEY)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image  # music_short.py scenes; needs a paid Gemini plan
VEO_MODEL=veo-3.1-fast-generate-preview  # music_short.py moving clips; needs a paid Gemini plan
MUSIC_VISUALS=stock                  # stock / veo / images / gradient
PEXELS_API_KEY=your_pexels_key_here  # free: https://www.pexels.com/api/ (stock clips for music_short.py)
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
